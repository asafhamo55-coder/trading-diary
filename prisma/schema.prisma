generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @unique
  calendarYear      Int      @default(2026)
  startingBalance   Float    // Starting balance — $178,600
  accountOpenBalance Float   // Account opening balance
  commissionPerShare Float   @default(0.01)
  minimumCommission  Float   @default(2.50)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trades            Trade[]
  monthlyReviews    MonthlyReview[]
  errorDefinitions  ErrorDefinition[]
  assetLeverages    AssetLeverage[]
  fundTransactions  FundTransaction[]
  properties        Property[]
}

// ── Hamo Properties ────────────────────────────────────────────────
// Minimal real-estate bookkeeping to support tax filing (Schedule E).

model Property {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])

  nickname      String
  address       String     // full one-line address (composed from the parts below; also the import idempotency key)
  street        String?    // street number + name, e.g. "123 Maple St"
  unit          String?    // apartment / unit #, e.g. "4B"
  city          String?
  state         String?    // state / province, e.g. "CA"
  zip           String?    // postal / ZIP code
  purchasePrice Float?
  downPayment   Float?     // cash invested at purchase
  purchaseDate  DateTime?
  currentValue  Float?     // latest market value / Zestimate
  valueAsOf     DateTime?  // date of the current value estimate
  mortgageBalance Float?   // outstanding mortgage principal (liability) — for equity
  mortgageAsOf  DateTime?  // date of the mortgage balance
  usage         String   @default("rental") // "rental" | "residence" (primary home: net worth only)
  notes         String?
  archivedAt    DateTime?  // null = active; set = archived (hidden from active list)

  // Single-value record sections (facts, HOA, insurance, property tax,
  // management, tax basis, major systems), validated by propertyProfileSchema
  // in src/lib/property-profile.ts.
  profile       Json?

  transactions  PropertyTransaction[]
  tenants       Tenant[]
  loans         PropertyLoan[]
  improvements  PropertyImprovement[]
  maintenance   PropertyMaintenance[]
  documents     PropertyDocument[]
  utilities     PropertyUtility[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
}

model Tenant {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name            String
  email           String?
  phone           String?
  leaseStart      DateTime
  leaseEnd        DateTime?  // null = current / ongoing lease
  monthlyRent     Float?
  securityDeposit Float?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, leaseStart])
}

// Mortgages, HELOCs and other loans secured by a property. The sum of the
// active loans' balances is mirrored onto Property.mortgageBalance.
model PropertyLoan {
  id             String    @id @default(cuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  kind           String    @default("first") // "first" | "second" | "heloc" | "other"
  lender         String?
  servicer       String?
  loanNumber     String?
  portalUrl      String?
  servicerPhone  String?
  originalAmount Float?
  startDate      DateTime?
  termMonths     Int?
  interestRate   Float?    // annual, percent (6.25 = 6.25%)
  rateType       String    @default("fixed") // "fixed" | "arm"
  armResetDate   DateTime?
  armIndex       String?
  armMargin      Float?    // percent
  monthlyPI      Float?
  escrowMonthly  Float?    // tax + insurance held by the servicer
  pmiMonthly     Float?
  pmiRemovalDate DateTime?
  maturityDate   DateTime?
  balance        Float?
  balanceAsOf    DateTime?
  active         Boolean   @default(true)
  notes          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([propertyId])
}

// Capital improvements (depreciable) and repairs (expensed).
model PropertyImprovement {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date        DateTime
  description String
  amount      Float
  category    String   @default("improvement") // "improvement" | "repair"
  notes       String?

  createdAt   DateTime @default(now())

  @@index([propertyId, date])
}

model PropertyMaintenance {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date          DateTime
  vendor        String?
  system        String?  // "roof" | "hvac" | "water_heater" | "appliances" | "plumbing" | "electrical" | "other"
  cost          Float?
  notes         String?
  transactionId String?  // optional link to the matching expense entry

  createdAt     DateTime @default(now())

  @@index([propertyId, date])
}

// Links only (e.g. Google Drive URLs); no file storage.
model PropertyDocument {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  type        String    // "deed" | "closing" | "lease" | "insurance" | "appraisal" | "tax_bill" | "hoa" | "other"
  title       String
  url         String
  date        DateTime?

  createdAt   DateTime  @default(now())

  @@index([propertyId])
}

model PropertyUtility {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  kind          String   // "electric" | "gas" | "water" | "sewer" | "trash" | "internet"
  provider      String?
  accountNumber String?
  paidBy        String   @default("tenant") // "tenant" | "owner"
  portalUrl     String?

  createdAt     DateTime @default(now())

  @@index([propertyId])
}

model PropertyTransaction {
  id          String             @id @default(cuid())
  propertyId  String
  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date        DateTime
  year        Int
  month       Int
  type        PropertyTxType
  category    String
  amount      Float              // always positive; sign implied by `type`
  description String?
  // Counted for tax (Schedule E) but ignored by every performance figure —
  // net, yield, cash-on-cash, cash-flow charts. See `forReturns` in property.ts.
  taxOnly     Boolean            @default(false)
  // Where a row came from when it wasn't typed in, e.g. "taxReturn:2025" for
  // the Schedule E backfill (re-ingesting a return replaces only its rows).
  source      String?

  createdAt   DateTime @default(now())

  @@index([propertyId, date])
  @@index([propertyId, year])
}

enum PropertyTxType {
  INCOME
  EXPENSE
}

model FundTransaction {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  // Positive = deposit, negative = withdrawal
  amount      Float
  comment     String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([accountId, occurredAt])
}

model Trade {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id])

  tradeDate         DateTime
  month             Int
  symbol            String
  brokerAccount     String?  // broker account number from the fill (e.g. "97634"); part of a trade's identity
  direction         Direction
  tradeType         String?
  isSwingContinuation Boolean @default(false)
  isAsset           Boolean  @default(false)

  entries           TradeLeg[]

  totalPositionValue Float?
  totalShares        Float?
  sharesInProcess    Float?
  avgBuyPrice        Float?
  avgSellPrice       Float?
  totalPnL           Float?
  riskReward         Float?
  returnOnPosition   Float?
  riskAmount         Float?
  totalCommissions   Float?
  isCompleted        Boolean @default(false)

  entryReason        String?
  exitReason         String?
  conclusions        String?
  chartUrl           String?
  notes              String?

  dailyHigh          Float?
  dailyClose         Float?
  moneyLeftHighPct   Float?
  moneyLeftClosePct  Float?

  tradeErrors        TradeError[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accountId, month])
  @@index([accountId, tradeDate])
  @@index([symbol])
  @@index([accountId, symbol, brokerAccount, isCompleted])
}

enum Direction {
  LONG
  SHORT
}

model TradeLeg {
  id          String  @id @default(cuid())
  tradeId     String
  trade       Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  legType     LegType
  price       Float
  quantity    Float
  commission  Float   @default(0)
  legOrder    Int
  externalKey String?   // idempotency key for email-ingested legs (Gmail message-id)
  filledAt    DateTime? // when this buy/sell was filled/logged (email date for ingested fills)

  @@index([tradeId])
  @@index([externalKey])
}

enum LegType {
  BUY
  SELL
}

model MonthlyReview {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  month           Int
  year            Int      @default(2026)

  portfolioStartValue  Float?
  portfolioEndValue    Float?
  riskUnit             Float?

  goal1           String?
  goal2           String?
  goal3           String?
  goalsMet        String?

  monthlyConclusions String?
  keyLessons         String?

  useFixedRiskUnit   Boolean @default(false)
  includeOpenTrades  Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([accountId, month, year])
}

model ErrorDefinition {
  id          String  @id @default(cuid())
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  name        String
  sortOrder   Int     @default(0)

  tradeErrors TradeError[]

  @@unique([accountId, name])
}

model TradeError {
  id              String          @id @default(cuid())
  tradeId         String
  trade           Trade           @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  errorDefinitionId String
  errorDefinition ErrorDefinition @relation(fields: [errorDefinitionId], references: [id])

  @@unique([tradeId, errorDefinitionId])
}

model AssetLeverage {
  id          String  @id @default(cuid())
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  symbol      String
  leverage    Float   @default(1)

  @@unique([accountId, symbol])
}

// ── Hamo Home ──────────────────────────────────────────────────────
// Household finance: import bank & card statements, de-duplicate
// card-payment transfers, categorize (two-level), and analyze spending.
// `accountId` is the owning Account.id, stored as a plain field (no Prisma
// relation) to keep this module decoupled from the trading models.

enum HomeAccountType {
  BOFA_CHECKING
  BOFA_CARD
  AMEX
  OTHER
}

enum HomeCategoryKind {
  SPENDING
  INCOME
  TRANSFER // internal transfers / card payments — excluded from spend
}

model HomeAccount {
  id         String          @id @default(cuid())
  accountId  String
  name       String
  type       HomeAccountType
  last4      String?
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  transactions HomeTransaction[]
  imports      HomeImport[]

  @@index([accountId])
}

model HomeCategory {
  id        String           @id @default(cuid())
  accountId String
  name      String
  parentId  String?
  parent    HomeCategory?    @relation("HomeCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  HomeCategory[]   @relation("HomeCategoryTree")
  kind      HomeCategoryKind @default(SPENDING)
  color     String?
  sortOrder Int              @default(0)
  isSystem  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  transactions HomeTransaction[]
  rules        HomeCategoryRule[]

  @@index([accountId])
}

model HomeTransaction {
  id             String       @id @default(cuid())
  accountId      String
  homeAccountId  String
  homeAccount    HomeAccount  @relation(fields: [homeAccountId], references: [id], onDelete: Cascade)

  date           DateTime
  year           Int
  month          Int
  amount         Float // signed: negative = money out, positive = money in
  description    String // cleaned merchant / description
  rawDescription String // original statement text (never lost)

  categoryId     String?
  category       HomeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  propertyId     String? // attributes this expense to a Hamo Properties property

  notes          String?
  isExcluded     Boolean      @default(false) // transfers / card payments removed from spend
  excludeReason  String?
  dedupeGroupId  String? // links a bank card-payment to its card-side offset
  needsReview    Boolean      @default(false)
  isManual       Boolean      @default(false) // user-added, not imported

  importId       String?
  import         HomeImport?  @relation(fields: [importId], references: [id], onDelete: SetNull)
  externalKey    String? // idempotency key for imported rows

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accountId, date])
  @@index([accountId, year, month])
  @@index([homeAccountId])
  @@index([externalKey])
}

model HomeImport {
  id             String          @id @default(cuid())
  accountId      String
  homeAccountId  String
  homeAccount    HomeAccount     @relation(fields: [homeAccountId], references: [id], onDelete: Cascade)
  filename       String
  source         HomeAccountType
  rowCount       Int             @default(0)
  addedCount     Int             @default(0)
  duplicateCount Int             @default(0)
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime        @default(now())

  transactions HomeTransaction[]

  @@index([accountId])
}

model HomeCategoryRule {
  id         String        @id @default(cuid())
  accountId  String
  matcher    String // lowercased substring matched against rawDescription
  categoryId String?
  category   HomeCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  propertyId String? // learned merchant → property attribution
  priority   Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([accountId])
}

// ── Hamo Savings / Net Worth ───────────────────────────────────────
// Long-term savings (Israeli pension / manager's insurance / hishtalmut /
// gemel, US 401(k) / IRA, brokerage, cash) consolidated with Properties,
// Trade and Home into one household net worth, plus the AI advisor.
// `accountId` is the owning Account.id as a plain field (no relation), like
// Hamo Home. Owner/type/country are validated strings (see
// savings-validators.ts) so new values need no enum migration.
// DDL lives in src/lib/savings-schema.ts (self-heal, no manual migration).

model SavingsAccount {
  id                      String    @id @default(cuid())
  accountId               String
  owner                   String    // household member key: "asaf" | "einat" | "joint" | a child's key
  country                 String    // "IL" | "US"
  type                    String    // pension | managers_insurance | hishtalmut | gemel | gemel_investment | savings_policy | savings_child | 401k | ira | brokerage | rsu | cash | other
  provider                String
  planName                String?
  policyLast4             String?   // only the last 4 digits of the policy/account number are stored
  policyNumber            String?   // full policy/account number (user opted in)
  loginUrl                String?   // provider sign-in page; null = provider default
  status                  String?
  currency                String    @default("ILS") // "ILS" | "USD"
  balance                 Float     @default(0)
  balanceAsOf             DateTime?
  track                   String?   // investment track (מסלול השקעה)
  feeDepositPct           Float?    // דמי ניהול מהפקדה, % of each deposit
  feeAccumulationPct      Float?    // דמי ניהול מצבירה, % of balance per year
  monthlyDepositEmployee  Float?
  monthlyDepositEmployer  Float?
  monthlyDepositSeverance Float?
  monthlyDepositTotal     Float?    // as reported; may exceed the split sum
  insuredSalary           Float?
  liquidityDate           DateTime?
  projectedMonthlyPension Float?
  details                 Json?     // everything else: coverages, returns, conversion factors, notes, sourcePage…
  source                  String    @default("manual") // "pdf-import" | "manual"
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  snapshots SavingsSnapshot[]

  @@index([accountId])
  @@index([accountId, owner, provider, type])
}

model SavingsSnapshot {
  id               String         @id @default(cuid())
  savingsAccountId String
  savingsAccount   SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  asOf             DateTime
  balance          Float
  createdAt        DateTime       @default(now())

  @@unique([savingsAccountId, asOf])
}

model HouseholdProfile {
  id            String   @id @default(cuid())
  accountId     String   @unique
  members       Json?    // HouseholdMember[] — see savings.ts
  goals         Json?    // HouseholdGoals — see savings.ts
  goalsText     String?  // free-text goals
  riskTolerance String?  // "conservative" | "moderate" | "aggressive" | free text
  usdIlsRate    Float?   // FX override (ILS per 1 USD)
  contacts      Json?    // HouseholdContact[] — agents/CPA/HR, see savings.ts
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdvisorReport {
  id        String   @id @default(cuid())
  accountId String
  model     String
  inputHash String
  snapshot  Json     // the context sent to the model
  output    Json     // AdvisorOutput (structured recommendations)
  usage     Json     // tokens, estimated cost, served-by model
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([inputHash])
}

// Ticked advisor action items. Keyed by actionKey(recId, task) — a hash of the
// recommendation's stable slug + the normalized task text — so a tick survives
// the daily report regeneration (see src/lib/advisor-report.ts).
model AdvisorActionStatus {
  id        String    @id @default(cuid())
  accountId String
  key       String
  recId     String
  task      String
  done      Boolean   @default(false)
  doneAt    DateTime?
  reportId  String?   // report the item was last toggled on (audit only)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([accountId, key])
}

// Filed tax returns, extracted by the import-tax-return Claude Code skill.
// One row per account × tax year × jurisdiction; `data` is validated by
// src/lib/tax-return-schema.ts (no PII). DDL in src/lib/savings-schema.ts.
model TaxReturn {
  id           String   @id @default(cuid())
  accountId    String
  taxYear      Int
  jurisdiction String // "US-federal" | "US-GA"
  filingStatus String?
  preparer     String?
  source       String?
  partial      Boolean  @default(false)
  amended      Boolean  @default(false)
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([accountId, taxYear, jurisdiction])
}

// Insurance & employer benefits across both countries — used to spot coverage
// that duplicates (US employer life + Israeli term life + death cover inside a
// pension) or is missing (no disability / loss-of-work-capacity cover).
model Benefit {
  id                     String    @id @default(cuid())
  accountId              String
  owner                  String    // household member key
  country                String    // "IL" | "US"
  source                 String    // "employer:<name>" | "Clal" | "Migdal" | "private" …
  category               String    // life | add | ltd | std | work_capacity | health | dental | vision | critical_illness | long_term_care | hsa | fsa | espp | 401k_match | other
  coverageAmount         Float?
  coverageCurrency       String?   // "ILS" | "USD"
  monthlyCost            Float?
  costCurrency           String?
  payer                  String?   // "employee" | "employer" | "split"
  beneficiary            String?
  endsAt                 DateTime?
  linkedSavingsAccountId String?   // coverage living inside a pension / manager's-insurance policy
  details                Json?
  origin                 String    @default("manual") // "pdf-import" | "manual"
  importKey              String?   // idempotency key for imported rows
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([accountId, owner])
  @@index([linkedSavingsAccountId])
  @@index([importKey])
}

// ── Trade guidelines ───────────────────────────────────────────────
// House rules for the stocks account (target mix, rebalance band, dip rule).
// One row per Account; `config` is a GuidelineConfig (src/lib/guidelines.ts),
// validated with zod on write. `accountId` is a plain field (no relation),
// like HouseholdProfile. DDL: src/lib/guidelines-schema.ts (self-heal).
model TradingGuideline {
  id        String   @id @default(cuid())
  accountId String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// In-app "Ask" assistant (see docs/assistant.md). The app never calls an LLM:
// a Claude Code routine on the user's subscription fetches pending questions
// from /api/assistant/pending and posts answers to /api/assistant/answer.
// Self-healed by src/lib/assistant-schema.ts.
model AssistantQuestion {
  id          String    @id @default(cuid())
  accountId   String
  question    String
  language    String    @default("en") // "he" | "en", detected from the question text
  pagePath    String
  pageTitle   String?
  contextKeys Json?     // string[]: glossary keys + entity refs ("property:<id>", "savings:<id>", "guidelines")
  status      String    @default("pending") // "pending" | "answered" | "failed"
  answer      String?   // markdown (or the failure reason when status = "failed")
  answeredAt  DateTime?
  answeredBy  String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([accountId, createdAt])
  @@index([status, createdAt])
}
