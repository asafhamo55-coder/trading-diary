generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @unique
  calendarYear      Int      @default(2026)
  startingBalance   Float    // Starting balance — $178,600
  accountOpenBalance Float   // Account opening balance
  commissionPerShare Float   @default(0.01)
  minimumCommission  Float   @default(2.50)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trades            Trade[]
  monthlyReviews    MonthlyReview[]
  errorDefinitions  ErrorDefinition[]
  assetLeverages    AssetLeverage[]
  fundTransactions  FundTransaction[]
  properties        Property[]
}

// ── Hamo Properties ────────────────────────────────────────────────
// Minimal real-estate bookkeeping to support tax filing (Schedule E).

model Property {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])

  nickname      String
  address       String     // full one-line address (composed from the parts below; also the import idempotency key)
  street        String?    // street number + name, e.g. "123 Maple St"
  unit          String?    // apartment / unit #, e.g. "4B"
  city          String?
  state         String?    // state / province, e.g. "CA"
  zip           String?    // postal / ZIP code
  purchasePrice Float?
  purchaseDate  DateTime?
  notes         String?
  archivedAt    DateTime?  // null = active; set = archived (hidden from active list)

  transactions  PropertyTransaction[]
  tenants       Tenant[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([accountId])
}

model Tenant {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name            String
  email           String?
  phone           String?
  leaseStart      DateTime
  leaseEnd        DateTime?  // null = current / ongoing lease
  monthlyRent     Float?
  securityDeposit Float?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, leaseStart])
}

model PropertyTransaction {
  id          String             @id @default(cuid())
  propertyId  String
  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  date        DateTime
  year        Int
  month       Int
  type        PropertyTxType
  category    String
  amount      Float              // always positive; sign implied by `type`
  description String?

  createdAt   DateTime @default(now())

  @@index([propertyId, date])
  @@index([propertyId, year])
}

enum PropertyTxType {
  INCOME
  EXPENSE
}

model FundTransaction {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id])
  // Positive = deposit, negative = withdrawal
  amount      Float
  comment     String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([accountId, occurredAt])
}

model Trade {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id])

  tradeDate         DateTime
  month             Int
  symbol            String
  direction         Direction
  tradeType         String?
  isSwingContinuation Boolean @default(false)
  isAsset           Boolean  @default(false)

  entries           TradeLeg[]

  totalPositionValue Float?
  totalShares        Float?
  sharesInProcess    Float?
  avgBuyPrice        Float?
  avgSellPrice       Float?
  totalPnL           Float?
  riskReward         Float?
  returnOnPosition   Float?
  riskAmount         Float?
  totalCommissions   Float?
  isCompleted        Boolean @default(false)

  entryReason        String?
  exitReason         String?
  conclusions        String?
  chartUrl           String?
  notes              String?

  dailyHigh          Float?
  dailyClose         Float?
  moneyLeftHighPct   Float?
  moneyLeftClosePct  Float?

  tradeErrors        TradeError[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accountId, month])
  @@index([accountId, tradeDate])
  @@index([symbol])
}

enum Direction {
  LONG
  SHORT
}

model TradeLeg {
  id          String  @id @default(cuid())
  tradeId     String
  trade       Trade   @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  legType     LegType
  price       Float
  quantity    Float
  commission  Float   @default(0)
  legOrder    Int

  @@index([tradeId])
}

enum LegType {
  BUY
  SELL
}

model MonthlyReview {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  month           Int
  year            Int      @default(2026)

  portfolioStartValue  Float?
  portfolioEndValue    Float?
  riskUnit             Float?

  goal1           String?
  goal2           String?
  goal3           String?
  goalsMet        String?

  monthlyConclusions String?
  keyLessons         String?

  useFixedRiskUnit   Boolean @default(false)
  includeOpenTrades  Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([accountId, month, year])
}

model ErrorDefinition {
  id          String  @id @default(cuid())
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  name        String
  sortOrder   Int     @default(0)

  tradeErrors TradeError[]

  @@unique([accountId, name])
}

model TradeError {
  id              String          @id @default(cuid())
  tradeId         String
  trade           Trade           @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  errorDefinitionId String
  errorDefinition ErrorDefinition @relation(fields: [errorDefinitionId], references: [id])

  @@unique([tradeId, errorDefinitionId])
}

model AssetLeverage {
  id          String  @id @default(cuid())
  accountId   String
  account     Account @relation(fields: [accountId], references: [id])
  symbol      String
  leverage    Float   @default(1)

  @@unique([accountId, symbol])
}

// ── Hamo Home ──────────────────────────────────────────────────────
// Household finance: import bank & card statements, de-duplicate
// card-payment transfers, categorize (two-level), and analyze spending.
// `accountId` is the owning Account.id, stored as a plain field (no Prisma
// relation) to keep this module decoupled from the trading models.

enum HomeAccountType {
  BOFA_CHECKING
  BOFA_CARD
  AMEX
  OTHER
}

enum HomeCategoryKind {
  SPENDING
  INCOME
  TRANSFER // internal transfers / card payments — excluded from spend
}

model HomeAccount {
  id         String          @id @default(cuid())
  accountId  String
  name       String
  type       HomeAccountType
  last4      String?
  archivedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  transactions HomeTransaction[]
  imports      HomeImport[]

  @@index([accountId])
}

model HomeCategory {
  id        String           @id @default(cuid())
  accountId String
  name      String
  parentId  String?
  parent    HomeCategory?    @relation("HomeCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  HomeCategory[]   @relation("HomeCategoryTree")
  kind      HomeCategoryKind @default(SPENDING)
  color     String?
  sortOrder Int              @default(0)
  isSystem  Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  transactions HomeTransaction[]
  rules        HomeCategoryRule[]

  @@index([accountId])
}

model HomeTransaction {
  id             String       @id @default(cuid())
  accountId      String
  homeAccountId  String
  homeAccount    HomeAccount  @relation(fields: [homeAccountId], references: [id], onDelete: Cascade)

  date           DateTime
  year           Int
  month          Int
  amount         Float // signed: negative = money out, positive = money in
  description    String // cleaned merchant / description
  rawDescription String // original statement text (never lost)

  categoryId     String?
  category       HomeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  notes          String?
  isExcluded     Boolean      @default(false) // transfers / card payments removed from spend
  excludeReason  String?
  dedupeGroupId  String? // links a bank card-payment to its card-side offset
  needsReview    Boolean      @default(false)
  isManual       Boolean      @default(false) // user-added, not imported

  importId       String?
  import         HomeImport?  @relation(fields: [importId], references: [id], onDelete: SetNull)
  externalKey    String? // idempotency key for imported rows

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accountId, date])
  @@index([accountId, year, month])
  @@index([homeAccountId])
  @@index([externalKey])
}

model HomeImport {
  id             String          @id @default(cuid())
  accountId      String
  homeAccountId  String
  homeAccount    HomeAccount     @relation(fields: [homeAccountId], references: [id], onDelete: Cascade)
  filename       String
  source         HomeAccountType
  rowCount       Int             @default(0)
  addedCount     Int             @default(0)
  duplicateCount Int             @default(0)
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime        @default(now())

  transactions HomeTransaction[]

  @@index([accountId])
}

model HomeCategoryRule {
  id         String       @id @default(cuid())
  accountId  String
  matcher    String // lowercased substring matched against rawDescription
  categoryId String
  category   HomeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priority   Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([accountId])
}
